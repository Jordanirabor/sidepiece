# ---- Production (docker-compose.yml / Dokploy) ----
# Generate secrets with: openssl rand -base64 48
PUBLIC_API_URL=https://api.example.com
ROOM_WS_PUBLIC_URL=wss://ws.example.com/ws
CORS_ORIGINS=https://play.example.com
JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RUST_LOG=info

# NPC conversations: any OpenAI-compatible endpoint. Empty = built-in offline scorer.
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<provider/model>
#   Ollama:     LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=llama3.1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional MinIO overlay
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
